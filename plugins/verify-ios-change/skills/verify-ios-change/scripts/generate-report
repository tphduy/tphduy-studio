#!/usr/bin/env python3
"""Generate standalone index.html from RUN_DIR/manifest.json.

Usage: generate-report RUN_DIR
Print the report path on success; leave an existing report intact on failure.
Python 3 standard library only.
"""
import json
from pathlib import Path
import re
import sys
import tempfile


TEMPLATE = Path(__file__).resolve().parent.parent / "assets" / "index.html"
SLOT = re.compile(r'(<script type="application/json" id="manifest">).*?(</script>)', re.S)


def generate_report(run_dir):
    run_dir = Path(run_dir).resolve()
    manifest = json.loads((run_dir / "manifest.json").read_text(encoding="utf-8"))
    if not isinstance(manifest, dict) or manifest.get("schema") != 6:
        raise ValueError("manifest.json must use schema 6")
    template = TEMPLATE.read_text(encoding="utf-8")
    if len(SLOT.findall(template)) != 1:
        raise ValueError("report template must contain exactly one manifest script element")
    # Escaping every '<' also prevents HTML's script double-escaped state.
    embedded = json.dumps(manifest, ensure_ascii=False, indent=2).replace("<", "\\u003c")
    html = SLOT.sub(lambda match: match[1] + "\n" + embedded + "\n" + match[2], template)
    report = run_dir / "index.html"
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(
            mode="w", encoding="utf-8", dir=run_dir, prefix=".index-", suffix=".tmp", delete=False,
        ) as output:
            temporary = Path(output.name)
            output.write(html)
        temporary.replace(report)
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)
    return report


def main():
    if len(sys.argv) != 2:
        print("usage: generate-report RUN_DIR", file=sys.stderr)
        return 2
    try:
        print(generate_report(sys.argv[1]))
    except (OSError, ValueError) as error:
        print(f"ERROR: Could not generate report: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
